---
const siteTitle = "Ixthys Analytics & Aletheon LLC";
const tagline = "Data Analysis • BI Reporting • Workflow Optimization";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>{siteTitle}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <style>
      body {
        font-family: system-ui, sans-serif;
        margin: 0;
        padding: 0;
        background: #f7f7f7;
        color: #222;
      }
      header {
        background: #1a1a1a;
        color: white;
        padding: 1.5rem;
        text-align: center;
      }
      nav a {
        margin: 0 1rem;
        color: #ddd;
        text-decoration: none;
        font-weight: 500;
      }
      nav a:hover {
        color: white;
      }
      .hero {
        padding: 4rem 2rem;
        text-align: center;
      }
      .hero h1 {
        font-size: 2.5rem;
        margin-bottom: 1rem;
      }
      .hero p {
        font-size: 1.25rem;
        max-width: 600px;
        margin: 0 auto;
        line-height: 1.6;
      }
      .cta {
        margin-top: 2rem;
      }
      .cta a {
        background: #0077ff;
        color: white;
        padding: 0.75rem 1.5rem;
        border-radius: 6px;
        text-decoration: none;
        font-weight: 600;
      }
      .cta a:hover {
        background: #005fcc;
      }
      footer {
        margin-top: 4rem;
        padding: 2rem;
        text-align: center;
        font-size: 0.9rem;
        color: #555;
      }
    </style>
  </head>

  <body>
    <header>
      <h2>{siteTitle}</h2>
      <nav>
        <a href="/about">About</a>
        <a href="/portfolio">Portfolio</a>
        <a href="/contact">Contact</a>
      </nav>
    </header>

    <section class="hero">
      <h1>{tagline}</h1>
      <p>
        Welcome. I’m Joe DeMaio — a data analyst with 10+ years of experience in
        SQL, BI reporting, workflow analysis, and data quality. I help
        organizations make better decisions through clean data, clear reporting,
        and efficient processes.
      </p>

      <div class="cta">
        <a href="/portfolio">View My Work</a>
      </div>
    </section>

    <footer>
      © {new Date().getFullYear()} Ixthys Analytics & Aletheon LLC
    </footer>
  </body>
</html>
