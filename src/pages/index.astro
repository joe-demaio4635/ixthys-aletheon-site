---
const siteTitle = "Ixthys Analytics";
const tagline = "Data Analysis • BI Reporting • Workflow Optimization";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{siteTitle}</title>

    <style>
      body {
        font-family: Arial, sans-serif;
        max-width: 1000px;
        margin: 0 auto;
        padding: 20px;
        line-height: 1.6;
      }

      header {
        border-bottom: 1px solid #ddd;
        margin-bottom: 2rem;
      }

      nav a {
        margin-right: 1rem;
        text-decoration: none;
        color: #0066cc;
      }

      nav a:hover {
        text-decoration: underline;
      }

      .hero {
        margin-top: 2rem;
      }
    </style>
  </head>

  <body>
    <header>
      <h2>{siteTitle}</h2>

      <nav>
      <a>/aboutAbout</a>
      <a>/portfolioPortfolio</a>
      <a>/contactContact</a>
      </nav>
    </header>

    <section class="hero">
      <h1>{tagline}</h1>

      <p>
        Welcome. I'm Joe DeMaio, a data analyst specializing in SQL, Power BI,
        workflow analysis, business intelligence reporting, and process
        improvement.
      </p>

      <p>
        Explore my portfolio to see examples of dashboards, reporting
        solutions, and analytics projects.
      </p>
    </section>
  </body>
</html>
