---
const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    /favicon.svg
    <title>{title} | Ixthys Analytics</title>
</head>

<body>
    <header>
        <h1>Ixthys Analytics</h1>

        <nav>
            <a hrefa>
            <aboutAbout</a>
            /portfolioPortfolio</a>
            /contactContact</a>
        </nav>
    </header>

    <main>
        <slot />
    </main>

    <footer>
        <p>© 2026 Joe DeMaio</p>
    </footer>
</body>
</html>

<style>
    html {
        font-family: Arial, Helvetica, sans-serif;
    }

    body {
        margin: 0;
        max-width: 1000px;
        padding: 20px;
        margin: 0 auto;
        line-height: 1.6;
    }

    header {
        border-bottom: 1px solid #ddd;
        margin-bottom: 2rem;
    }

    nav {
        margin-bottom: 1rem;
    }

    nav a {
        margin-right: 1rem;
        text-decoration: none;
        color: #0066cc;
    }

    nav a:hover {
        text-decoration: underline;
    }

    footer {
        margin-top: 3rem;
        border-top: 1px solid #ddd;
        padding-top: 1rem;
    }
</style>